# Public browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only AI Gateway credential. Never prefix with NEXT_PUBLIC_.
# On Vercel, OIDC may be used instead if enabled for the project.
AI_GATEWAY_API_KEY=

# Optional model overrides. Verify model IDs against the live Gateway catalog.
JANE_QUICK_MODEL=openai/gpt-4.1-mini
JANE_WORK_MODEL=openai/gpt-5-mini
